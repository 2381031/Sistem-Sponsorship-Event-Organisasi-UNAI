{
  "name": "unai-sponsorship-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "tsc -p tsconfig.build.json && esbuild dist/main.js --bundle --platform=node --format=cjs --outfile=../api/_backend.js --minify --external:@nestjs/websockets --external:@nestjs/microservices",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "lint": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.2.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.2",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@swc/core": "^1.15.46",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
